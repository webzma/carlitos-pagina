---
interface Props {
  links: { href: string; label: string }[];
}
const { links } = Astro.props;
---

<header class="header">
  <div class="container">
    <a href="/" class="logo"><span class="logo-mark">☘️</span><span>SORTEOS <b>EL TRÉBOL</b></span></a>
    <button class="menu-btn" aria-label="Menú">☰</button>
    <nav class="nav">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector(".nav")!;
  document.querySelector(".menu-btn")?.addEventListener("click", () => nav.classList.toggle("open"));
  nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => nav.classList.remove("open")));
</script>
