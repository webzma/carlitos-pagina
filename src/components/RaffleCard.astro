---
import { type Rifa, money, fmtDate } from "../data/config";

interface Props {
  rifa: Rifa;
  vendidos: number;
}
const { rifa, vendidos } = Astro.props;
const activa = rifa.estado === "activa";
const pct = Math.round((vendidos / rifa.totalBoletos) * 100);
---

<article class="card">
  <div class:list={["card-img", rifa.estilo]}>
    <span class:list={["badge", activa ? "live" : "done"]}>{activa ? "En venta" : "Finalizada"}</span>
    {rifa.icono}
  </div>
  <div class="card-body">
    <h3>{rifa.titulo}</h3>
    <p style="color:var(--muted);font-size:.92rem">{rifa.descripcion}</p>
    <div class="meta"><span>📅 {fmtDate(rifa.fecha)}</span><span>Boleto: <b>{money(rifa.precio)}</b></span></div>
    {
      activa ? (
        <>
          <div class="progress"><div style={`width:${pct}%`} /></div>
          <div class="progress-label"><span>Vendidos</span><span>{pct}%</span></div>
          <a href={`/rifas/${rifa.id}`} class="btn btn-primary btn-block">🎟️ Boletos disponibles</a>
        </>
      ) : (
        <>
          <div class="meta"><span>🏆 Ganador</span><b>{rifa.ganador}</b></div>
          <a href={`/rifas/${rifa.id}`} class="btn btn-ghost btn-block">Ver evento</a>
        </>
      )
    }
  </div>
</article>
