---
import { CUENTAS } from "../data/config";

interface Props {
  subtitle?: string;
}
const { subtitle = "Toca “Copiar” para copiar cada dato en tu app del banco." } = Astro.props;
---

<section class="section" id="cuentas">
  <div class="container">
    <h2 class="section-title">CUENTAS <span>DE PAGO</span></h2>
    <p class="section-sub">{subtitle}</p>
    <div class="accounts">
      {
        CUENTAS.map((c) => (
          <div class="account">
            <div class="account-head">
              <div class="account-logo" style={`background:${c.color}`}>{c.sigla}</div>
              <div>
                <h4>{c.nombre}</h4>
                <small>{c.sub}</small>
              </div>
            </div>
            {c.datos.map(([k, v]) => (
              <div class="account-row">
                <span>{k}</span>
                <div>
                  {v} <button class="copy" data-copy={v}>Copiar</button>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
