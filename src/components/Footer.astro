---
import Icon from "./Icon.astro";
import { SITE, waLink } from "../data/config";

const year = new Date().getFullYear();
---

<footer class="footer" id="contacto">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo" style="margin-bottom:14px">
          <span class="logo-mark">☘️</span><span>SORTEOS <b>EL TRÉBOL</b></span>
        </a>
        <p>Rifas transparentes, sorteadas con loterías oficiales. Cada boleto es una oportunidad real de ganar. ¡La suerte está de tu lado!</p>
      </div>
      <div>
        <h5>Contacto</h5>
        <ul>
          <li>📍 {SITE.ciudad}</li>
          <li><a href={waLink()} target="_blank" rel="noopener">📞 +{SITE.whatsapp}</a></li>
          <li>✉️ {SITE.email}</li>
        </ul>
      </div>
      <div>
        <h5>Síguenos</h5>
        <div class="socials">
          <a href={SITE.instagram} aria-label="Instagram"><Icon name="ig" /></a>
          <a href={SITE.tiktok} aria-label="TikTok"><Icon name="tt" /></a>
          <a href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="wa" /></a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.marca}. Todos los derechos reservados.</span>
      <nav><a href="#">Condiciones</a><a href="#">Privacidad</a><a href="#">Responsabilidad</a></nav>
    </div>
  </div>
</footer>

<a class="wa-float" href={waLink("Hola, quiero información sobre las rifas 🍀")} target="_blank" rel="noopener">
  <Icon name="wa" /><span>Chat</span>
</a>
