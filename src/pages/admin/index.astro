---
import "../../styles/global.css";
import { esAdmin } from "../../lib/auth";
import { listarOrdenes, resumen, resumenPorRifa, resumenVacio, ESTADOS, type Estado } from "../../lib/db";
import { RIFAS, SITE, money } from "../../data/config";

const logueado = esAdmin(Astro.cookies);
const url = Astro.url;
const rifa = url.searchParams.get("rifa") ?? "";
const estadoParam = url.searchParams.get("estado") ?? "";
const estado = ESTADOS.includes(estadoParam as Estado) ? (estadoParam as Estado) : undefined;
const q = url.searchParams.get("q") ?? "";
const msg = url.searchParams.get("msg");
const tipo = url.searchParams.get("tipo") === "err" ? "err" : "ok";

const [ordenes, stats, resumenes] = logueado
  ? await Promise.all([listarOrdenes({ rifa: rifa || undefined, estado, q }), resumen(rifa || undefined), resumenPorRifa()])
  : [[], null, {} as Record<string, never>];
const porRifa = RIFAS.map((r) => ({ rifa: r, stats: resumenes[r.id] ?? resumenVacio() }));

const tituloRifa = (id: string) => RIFAS.find((r) => r.id === id)?.titulo ?? id;
const digitosDe = (id: string) => String((RIFAS.find((r) => r.id === id)?.totalBoletos ?? 1000) - 1).length;
const fecha = (s: string) =>
  new Date(`${s.replace(" ", "T")}Z`).toLocaleString("es-VE", {
    timeZone: "America/Caracas",
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  });

// URL actual sin el mensaje, para volver tras una acción
const volverUrl = new URL(url);
volverUrl.searchParams.delete("msg");
volverUrl.searchParams.delete("tipo");
const volver = volverUrl.pathname + volverUrl.search;

const tabHref = (e: string) => {
  const u = new URL(volverUrl);
  e ? u.searchParams.set("estado", e) : u.searchParams.delete("estado");
  return u.pathname + u.search;
};

const waComprador = (tel: string, nombre: string, id: string) =>
  `https://wa.me/${tel}?text=${encodeURIComponent(`Hola ${nombre.split(" ")[0]}, te escribimos de ${SITE.marca} sobre tu orden ${id}.`)}`;

const ESTADO_TEXTO: Record<Estado, string> = { pendiente: "Pendiente", aprobado: "Aprobado", rechazado: "Rechazado" };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | {SITE.marca}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body">
    <header class="admin-top">
      <div class="container">
        <a href="/admin" class="logo"><span class="logo-mark">🏆</span><span>PANEL <b>EL TRIUNFO</b></span></a>
        {
          logueado && (
            <form method="post" action="/api/admin/logout">
              <button>Cerrar sesión</button>
            </form>
          )
        }
      </div>
    </header>

    {
      !logueado ? (
        <main class="container">
          <form class="login-box" method="post" action="/api/admin/login">
            <h1 style="font-family:var(--display);font-size:2.2rem;letter-spacing:1px">ACCESO ADMIN</h1>
            <p>Ingresa la contraseña para ver las órdenes y validar pagos.</p>
            {url.searchParams.has("error") && <p class="error">Contraseña incorrecta</p>}
            <div class="field" style="text-align:left">
              <label>Contraseña</label>
              <input type="password" name="password" required autofocus autocomplete="current-password" />
            </div>
            <button class="btn btn-primary btn-block">Entrar</button>
          </form>
        </main>
      ) : (
        <main class="container admin-main">
          <h1>ÓRDENES Y PAGOS</h1>

          {msg && <div class:list={["flash-msg", tipo]}>{msg}</div>}

          <div class="kpis">
            <div class="kpi warn">
              <span>Por validar</span>
              <strong>{stats!.pendiente.ordenes}</strong>
              <small class="muted">{money(stats!.pendiente.total)} · {stats!.pendiente.boletos} boletos</small>
            </div>
            <div class="kpi ok">
              <span>Recaudado (aprobado)</span>
              <strong>{money(stats!.aprobado.total)}</strong>
              <small class="muted">{stats!.aprobado.ordenes} órdenes</small>
            </div>
            <div class="kpi">
              <span>Boletos aprobados</span>
              <strong>{stats!.aprobado.boletos}</strong>
              <small class="muted">+{stats!.pendiente.boletos} apartados</small>
            </div>
            <div class="kpi">
              <span>Rechazadas</span>
              <strong>{stats!.rechazado.ordenes}</strong>
              <small class="muted">Números liberados</small>
            </div>
          </div>

          <section class="export">
            <h2>Exportar boletos para el sorteo</h2>
            <p class="muted">
              Solo se exportan los boletos <b>aprobados</b>. Valida los pendientes antes de exportar.
            </p>
            <div class="export-list">
              {
                porRifa.map(({ rifa: r, stats: st }) => (
                  <div class="export-row">
                    <div>
                      <b>{r.titulo}</b>
                      <span class="muted">
                        {st.aprobado.boletos} boletos aprobados
                        {st.pendiente.boletos > 0 && <span class="warn-text"> · ⚠ {st.pendiente.boletos} pendientes por validar</span>}
                      </span>
                    </div>
                    <div class="export-actions">
                      <a class="btn btn-dark btn-sm" href={`/api/admin/exportar?rifa=${r.id}&formato=csv`} aria-disabled={st.aprobado.boletos === 0}>⬇ Excel</a>
                      <a class="btn btn-ghost btn-sm" href={`/api/admin/exportar?rifa=${r.id}&formato=txt`} aria-disabled={st.aprobado.boletos === 0}>⬇ TXT</a>
                      <button class="btn btn-primary btn-sm" data-copy-rifa={r.id} disabled={st.aprobado.boletos === 0}>Copiar números</button>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <form class="filters" method="get">
            <select name="rifa" onchange="this.form.submit()">
              <option value="">Todas las rifas</option>
              {RIFAS.map((r) => <option value={r.id} selected={r.id === rifa}>{r.titulo}</option>)}
            </select>
            {estado && <input type="hidden" name="estado" value={estado} />}
            <input name="q" value={q} placeholder="Buscar por nombre, cédula, teléfono, referencia, orden o # de boleto" />
            <button class="btn btn-dark">Buscar</button>
            {(q || rifa || estado) && <a class="btn btn-ghost" href="/admin">Limpiar</a>}
          </form>

          <nav class="tabs">
            <a href={tabHref("")} class:list={{ on: !estado }}>Todas</a>
            {ESTADOS.map((e) => <a href={tabHref(e)} class:list={{ on: estado === e }}>{ESTADO_TEXTO[e]}</a>)}
          </nav>

          <div class="table-wrap">
            {
              ordenes.length === 0 ? (
                <p class="empty">No hay órdenes con estos filtros.</p>
              ) : (
                <table class="orders">
                  <thead>
                    <tr>
                      <th>Orden</th>
                      <th>Comprador</th>
                      <th>Rifa / boletos</th>
                      <th>Total</th>
                      <th>Pago</th>
                      <th>Estado</th>
                      <th>Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ordenes.map((o) => (
                      <tr>
                        <td>
                          <b>{o.id}</b>
                          <span class="muted">{fecha(o.creado)}</span>
                        </td>
                        <td class="who">
                          <b>{o.nombre}</b>
                          {o.cedula && <small>C.I. {o.cedula}</small>}
                          <a class="link" href={waComprador(o.telefono, o.nombre, o.id)} target="_blank" rel="noopener">
                            +{o.telefono}
                          </a>
                          {o.email && <small>{o.email}</small>}
                        </td>
                        <td>
                          <span class="muted">{tituloRifa(o.rifa_id)}</span>
                          <div class="nums" style="margin-top:4px">
                            {o.numeros.map((n) => <b>{String(n).padStart(digitosDe(o.rifa_id), "0")}</b>)}
                          </div>
                        </td>
                        <td><b>{money(o.total)}</b></td>
                        <td>
                          {o.referencia ? <div>Ref: <b>{o.referencia}</b></div> : <span class="muted">Sin referencia</span>}
                          {o.comprobante ? (
                            <a href={`/api/admin/comprobante/${o.id}`} target="_blank" rel="noopener" title="Ver comprobante">
                              <img class="thumb" src={`/api/admin/comprobante/${o.id}`} alt="Comprobante" loading="lazy" />
                            </a>
                          ) : (
                            <span class="muted">Sin captura</span>
                          )}
                        </td>
                        <td><span class:list={["status", o.estado]}>{ESTADO_TEXTO[o.estado]}</span></td>
                        <td>
                          <div class="actions">
                            {o.estado !== "aprobado" && (
                              <form method="post" action="/api/admin/orden">
                                <input type="hidden" name="id" value={o.id} />
                                <input type="hidden" name="estado" value="aprobado" />
                                <input type="hidden" name="volver" value={volver} />
                                <button class="act-ok">✓ Aprobar</button>
                              </form>
                            )}
                            {o.estado !== "rechazado" && (
                              <form method="post" action="/api/admin/orden" data-confirm={`¿Rechazar la orden ${o.id}? Sus números quedarán libres.`}>
                                <input type="hidden" name="id" value={o.id} />
                                <input type="hidden" name="estado" value="rechazado" />
                                <input type="hidden" name="volver" value={volver} />
                                <button class="act-no">✕ Rechazar</button>
                              </form>
                            )}
                            {o.estado !== "pendiente" && (
                              <form method="post" action="/api/admin/orden">
                                <input type="hidden" name="id" value={o.id} />
                                <input type="hidden" name="estado" value="pendiente" />
                                <input type="hidden" name="volver" value={volver} />
                                <button class="act-reset">↺ Pendiente</button>
                              </form>
                            )}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )
            }
          </div>
          <p class="muted" style="margin-top:12px;font-size:.85rem">{ordenes.length} orden(es) mostradas.</p>
        </main>
      )
    }

    <script>
      // Copia la lista de números aprobados (uno por línea) para pegarla en la plataforma del sorteo
      document.querySelectorAll<HTMLButtonElement>("[data-copy-rifa]").forEach((b) =>
        b.addEventListener("click", async () => {
          const original = b.textContent;
          try {
            const res = await fetch(`/api/admin/exportar?rifa=${b.dataset.copyRifa}&formato=txt`);
            if (!res.ok) throw new Error();
            await navigator.clipboard.writeText(await res.text());
            b.textContent = "✓ Copiado";
          } catch {
            b.textContent = "No se pudo copiar";
          }
          setTimeout(() => (b.textContent = original), 2000);
        }),
      );

      document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((f) =>
        f.addEventListener("submit", (e) => {
          if (!confirm(f.dataset.confirm!)) e.preventDefault();
        }),
      );
    </script>
  </body>
</html>
