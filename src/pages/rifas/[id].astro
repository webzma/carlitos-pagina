---
import Layout from "../../layouts/Layout.astro";
import Accounts from "../../components/Accounts.astro";
import { RIFAS, CUENTAS, SITE, premiosDe, paquetesDe, money, fmtDate } from "../../data/config";
import { vendidos } from "../../lib/db";

const rifa = RIFAS.find((r) => r.id === Astro.params.id);
if (!rifa) return Astro.redirect("/", 302);

const activa = rifa.estado === "activa";
const premios = premiosDe(rifa);
const paquetes = paquetesDe(rifa);
const ocupados = vendidos(rifa.id);
const pct = Math.round((ocupados.length / rifa.totalBoletos) * 100);
const digitos = String(rifa.totalBoletos - 1).length;

// Datos que necesita el script del navegador
const clientData = {
  id: rifa.id,
  titulo: rifa.titulo,
  precio: rifa.precio,
  totalBoletos: rifa.totalBoletos,
  fecha: rifa.fecha,
  paquetes,
  vendidos: ocupados,
  whatsapp: SITE.whatsapp,
  moneda: SITE.moneda,
};

const links = [
  { href: "/", label: "INICIO" },
  { href: "#boletos", label: "BOLETOS" },
  { href: "#premios", label: "PREMIOS" },
  { href: "#verificador", label: "VERIFICADOR" },
  { href: "#cuentas", label: "PAGO" },
  { href: "#contacto", label: "CONTACTO" },
];

const paises = [
  ["58", "🇻🇪"], ["57", "🇨🇴"], ["51", "🇵🇪"], ["56", "🇨🇱"],
  ["1", "🇺🇸"], ["34", "🇪🇸"], ["52", "🇲🇽"], ["593", "🇪🇨"],
];
---

<Layout title={rifa.titulo} description={`${rifa.titulo}: ${rifa.descripcion}. Boletos a ${money(rifa.precio)}.`} links={links}>
  <script type="application/json" id="rifa-data" set:html={JSON.stringify(clientData)} />

  <!-- Resumen -->
  <section class="raffle-hero">
    <div class="container raffle-top">
      <div class="prize-visual">
        <span class:list={["badge", activa ? "live" : "done"]}>{activa ? "En venta" : "Finalizada"}</span>
        {rifa.icono}
      </div>
      <div class="raffle-info">
        <h1>{rifa.titulo}</h1>
        <p class="lead">{rifa.descripcion}</p>
        <div class="info-grid">
          <div class="info-box"><span>Precio por boleto</span><strong class="red">{money(rifa.precio)}</strong></div>
          <div class="info-box"><span>Fecha del sorteo</span><strong>{fmtDate(rifa.fecha)}</strong></div>
          <div class="info-box"><span>Juega con</span><strong style="font-size:1rem">{rifa.loteria}</strong></div>
          <div class="info-box">
            <span>Disponibles</span><strong id="r-available">{rifa.totalBoletos - ocupados.length} / {rifa.totalBoletos}</strong>
          </div>
        </div>
        <div class="countdown">
          <div><b data-cd="d">00</b><small>Días</small></div>
          <div><b data-cd="h">00</b><small>Horas</small></div>
          <div><b data-cd="m">00</b><small>Min</small></div>
          <div><b data-cd="s">00</b><small>Seg</small></div>
        </div>
        <div class="progress"><div id="r-progress" style={`width:${pct}%`}></div></div>
        <div class="progress-label" style="margin-top:6px"><span>Boletos vendidos</span><span id="r-pct">{pct}%</span></div>
      </div>
    </div>
  </section>

  <!-- Selección de boletos -->
  <section class="section" id="boletos" style="padding-top:30px">
    <div class="container">
      <h2 class="section-title">ELIGE TUS <span>BOLETOS</span></h2>
      {
        activa ? (
          <p class="section-sub">Compra un paquete o escoge tus números uno por uno</p>
        ) : (
          <p class="section-sub">
            Esta rifa ya finalizó. 🏆 Ganador: <b class="red">{rifa.ganador}</b>
            <br /><br />
            <a class="btn btn-primary" href="/#rifas">Ver rifas disponibles</a>
          </p>
        )
      }

      {
        activa && (
          <div id="buy-area">
            <div class="packs" id="packs">
              {paquetes.map((p, i) => (
                <button class="pack" data-pack={i}>
                  {p.tag && <span class="tag">{p.tag}</span>}
                  <b>{p.cant}</b>
                  <small>boletos</small>
                  <span class="price">{money(rifa.precio * p.cant * (1 - p.desc))}</span>
                </button>
              ))}
            </div>

            <div class="panel">
              <div class="picker-tools">
                <input id="search" type="text" inputmode="numeric" maxlength={digitos} placeholder="Busca tu número (ej. 777)" />
                <button class="btn btn-ghost" id="btn-search">Buscar</button>
                <button class="btn btn-dark" id="btn-lucky">🎲 Elegir a la suerte</button>
                <button class="btn btn-ghost" id="btn-clear">Limpiar</button>
              </div>
              <div class="legend">
                <span><i class="l-free" />Disponible</span>
                <span><i class="l-sel" />Seleccionado</span>
                <span><i class="l-sold" />Vendido</span>
                <label><input type="checkbox" id="only-free" /> Mostrar solo disponibles</label>
              </div>
              <div class="grid-numbers" id="grid" />
            </div>

            <div class="cart">
              <div style="flex:1;min-width:200px">
                <div class="cart-total">
                  Seleccionados: <b id="sel-count">0</b> · Total: <b id="sel-total">{SITE.moneda}0</b>
                </div>
                <div class="cart-chips" id="chips" />
              </div>
              <button class="btn btn-primary" id="btn-continue" disabled>Continuar →</button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Premios -->
  <section class="section alt" id="premios">
    <div class="container">
      <h2 class="section-title">LISTA DE <span>PREMIOS</span></h2>
      <p class="section-sub">Se sortean con la {rifa.loteria}</p>
      <div class:list={["prizes-list", { single: premios.length < 3 }]}>
        {
          premios.map((p) => (
            <div class="prize">
              <div class="place">{p.lugar}</div>
              <div class="ico">{p.icono}</div>
              <h4>{p.titulo}</h4>
              <p>{p.detalle}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Verificador -->
  <section class="section" id="verificador">
    <div class="container verify">
      <h2 class="section-title">VERIFICADOR DE <span>BOLETOS</span></h2>
      <p class="section-sub">Ingresa tu número de teléfono o número de boleto</p>
      <form id="verify-form">
        <input id="verify-input" inputmode="numeric" placeholder="Teléfono o # de boleto" required />
        <button class="btn btn-primary">Buscar</button>
      </form>
      <div class="verify-result" id="verify-result"></div>
    </div>
  </section>

  <!-- Sorteador -->
  <section class="section alt" id="sorteador">
    <div class="container sorteador">
      <h2 class="section-title">SORTEADOR DE <span>BOLETOS</span></h2>
      <p class="section-sub">Simulador: prueba tu suerte antes del sorteo oficial</p>
      <div class="display" id="draw-display">{"0".repeat(digitos)}</div>
      <button class="btn btn-dark" id="btn-draw">🎲 Iniciar</button>
    </div>
  </section>

  <Accounts subtitle="¡Mucha suerte! 🏆" />

  <!-- Modal: compra -->
  <div class="modal" id="modal-buy">
    <div class="modal-box">
      <button class="modal-close" data-close>×</button>
      <h3>CONFIRMA TU COMPRA</h3>
      <p class="muted">Tus boletos quedan apartados al enviar el formulario mientras validamos el pago.</p>

      <form id="buy-form">
        <input type="hidden" name="rifa" value={rifa.id} />
        <input type="hidden" name="numeros" id="f-numeros" />

        <div class="form-step-title">1 · Datos personales</div>
        <div class="field"><label>Nombres y apellidos *</label><input name="nombre" required minlength="3" maxlength="120" /></div>
        <div class="field"><label>Cédula</label><input name="cedula" inputmode="numeric" maxlength="20" /></div>
        <div class="field">
          <label>Teléfono (WhatsApp) *</label>
          <div class="row-2">
            <select name="codigo">
              {paises.map(([code, flag]) => <option value={code}>{flag} +{code}</option>)}
            </select>
            <input name="telefono" inputmode="numeric" required placeholder="4120000000" maxlength="20" />
          </div>
        </div>
        <div class="field"><label>Correo electrónico</label><input name="email" type="email" maxlength="120" /></div>

        <div class="form-step-title">2 · Realiza el pago</div>
        {
          CUENTAS.map((c) => (
            <div class="pay-detail" style="margin-bottom:10px">
              <b>{c.nombre}</b> · {c.sub}
              {c.datos.map(([k, v]) => (
                <div>
                  {k}: <b>{v}</b> <button type="button" class="copy" data-copy={v}>Copiar</button>
                </div>
              ))}
              <span class="note">Monto a pagar: <b class="red pay-amount"></b>. Si pagas en bolívares, usa la tasa BCV del día.</span>
            </div>
          ))
        }

        <div class="form-step-title">3 · Comprobante de pago</div>
        <div class="field"><label>Número de referencia</label><input name="referencia" inputmode="numeric" maxlength="40" placeholder="Últimos dígitos de la referencia" /></div>
        <label class="upload">
          <span id="upload-text">📎 Toca para subir la captura del pago</span>
          <input type="file" name="comprobante" accept="image/jpeg,image/png,image/webp" hidden id="upload" />
        </label>
        <label class="check" style="margin-top:10px">
          <input type="checkbox" name="despues" value="1" id="later" /> Enviaré el comprobante más tarde por WhatsApp
        </label>

        <div class="summary-box"><span id="sum-nums"></span><b id="sum-total"></b></div>

        <label class="check"><input type="checkbox" required /> Autorizo el uso de mis datos personales para este sorteo.</label>
        <label class="check"><input type="checkbox" required /> Acepto los términos y condiciones.</label>

        <button class="btn btn-primary btn-block" style="margin-top:14px" id="btn-confirm">Confirmar</button>
      </form>
    </div>
  </div>

  <!-- Modal: éxito -->
  <div class="modal" id="modal-ok">
    <div class="modal-box success">
      <button class="modal-close" data-close>×</button>
      <div class="ico">🎉</div>
      <h3>¡BOLETOS REGISTRADOS!</h3>
      <p class="muted" id="ok-msg"></p>
      <div class="verify-result" id="ok-ticket"></div>
      <a class="btn btn-dark btn-block" id="ok-wa" target="_blank" rel="noopener">Enviar comprobante por WhatsApp</a>
      <button class="btn btn-ghost btn-block" style="margin-top:10px" data-close>Cerrar</button>
    </div>
  </div>
</Layout>

<script>
  import { initRifa } from "../../scripts/rifa";
  initRifa();
</script>
